# Video crudo de Playwright (el MP4 es el entregable)
demo/*.webm

# Capturas y JSON regenerables de la auditoría HIG
demo/hig-after/

# Artefactos que escriben los gates y E2E. Se regeneran; no se versionan.
# El full escribe estos paths, así que trackearlos ensuciaba gitAtEnd.
demo/mobile-*
demo/checkout-*
demo/rehearsal.json
demo/rehearsal-error.*
demo/tunnel-*
demo/stageshow/film-check.json
demo/stageshow/*-sheet*.png
demo/record-demo.json
demo/record-demo-error.*
harness/evidence/motion*
harness/evidence/a11y-contrast*
harness/evidence/mobile-*
harness/evidence/p0-*
harness/evidence/p0-shell/

# Sistema / editor
.DS_Store
Thumbs.db
demo/video/
__pycache__/
*.pyc

# Harness: runs, latest y latest-static son artefactos locales generados.
# latest.json se ata a la corrida full; latest-static.json a la static.
harness/evidence/runs/
harness/evidence/latest.json
harness/evidence/latest-static.json

# Capturas de auditoría: artefactos locales grandes. Los informes y JSON
# de evidencia sí se versionan; las PNG se conservan en el workspace.
quality-reports/**/*.png
