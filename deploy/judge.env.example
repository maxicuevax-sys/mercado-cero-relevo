# NOT deployable until placeholders are replaced. Copy outside Git, chmod 0600.
# Use the SAME protected file for Compose --env-file and JUDGE_RELEASE_ENV_FILE.
# Do not put secrets on command lines or print rendered Compose configuration.
JUDGE_RELEASE_ENV_FILE=/opt/mercado-cero/pilot/judge-release/release.env
JUDGE_RELEASE_DATA_DIR=/opt/mercado-cero/pilot/judge-release/data
# Use a real digest, not a mutable tag. A full-SHA tag may precede @sha256:.
JUDGE_RELEASE_IMAGE=localhost/mercado-cero:REPLACE_FULL_40_SHA@sha256:REPLACE_IMAGE_DIGEST
JUDGE_RELEASE_SHA=REPLACE_FULL_40_SHA
PILOT_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
DEMO_MODE=true
JUDGE_DEMO_ACCOUNTS=true
JUDGE_DATA_ROOT=/data/judges
APP_URL=https://mercado.zicua.com
DATABASE_PATH=/data/legacy-must-not-be-used.db
DATABASE_BACKUP_DIR=/data/backups
PEY_API_KEY=
PEY_WEBHOOK_SECRET=
OPENAI_API_KEY=
OPERATOR_ACCESS_TOKEN=
DEMO_RESET_TOKEN=
TRUST_PROXY=0
