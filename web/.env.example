# pey · https://portal.mipey.mx
# La presencia de PEY_API_KEY desactiva el modo demo automáticamente.
PEY_API_KEY=
PEY_WEBHOOK_SECRET=

# Opcional: cuenta bancaria CoDi específica para QR.
PEY_BANK_ACCOUNT_ID=

# STT local open source (faster-whisper). Sin OpenAI.
# Servicio: web/scripts/local-stt-server.py (puerto 4097).
# LOCAL_STT_URL=http://127.0.0.1:4097/transcribe

# URL pública HTTPS: obligatoria para links de pago y webhooks de pey.
APP_URL=https://tu-tunel.trycloudflare.com

# true = fuerza demo; false = fuerza producción. Si se omite, demo = no hay PEY_API_KEY.
# DEMO_MODE=true

# Ruta alternativa de SQLite.
# DATABASE_PATH=./data/mercado-cero.db

# Opcional: carpeta de backups VACUUM INTO antes de un reset.
# DATABASE_BACKUP_DIR=./data/backups

# Opcional y recomendado fuera de localhost: token de /api/demo/reset.
# La UI no lo envía; úsalo con curl/operación (x-demo-token o Bearer).
# DEMO_RESET_TOKEN=

# Escape hatch del reset: 1 permite reiniciar aun con pagos pey reales,
# conservando esos pagos, sus eventos y la auditoría. No usar por defecto.
# FORCE_DEMO_RESET=0
