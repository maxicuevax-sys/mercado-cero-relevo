# pey · https://portal.mipey.mx
# La presencia de PEY_API_KEY desactiva el modo demo automáticamente.
PEY_API_KEY=
PEY_WEBHOOK_SECRET=

# Opcional: cuenta bancaria CoDi específica para QR.
PEY_BANK_ACCOUNT_ID=

# OpenAI: sin key, el parser local de ventas sigue funcionando.
OPENAI_API_KEY=

# URL pública HTTPS: obligatoria para links de pago y webhooks de pey.
APP_URL=https://tu-tunel.trycloudflare.com

# true = fuerza demo; false = fuerza producción. Si se omite, demo = no hay PEY_API_KEY.
# DEMO_MODE=true

# Ruta alternativa de SQLite.
# DATABASE_PATH=./data/mercado-cero.db
