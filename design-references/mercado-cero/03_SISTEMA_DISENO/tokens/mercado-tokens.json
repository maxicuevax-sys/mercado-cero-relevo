{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "metadata": {
    "name": "Mercado Cero design tokens",
    "edition": "1.0",
    "source": "creative reconstruction from provided raster board",
    "status": "proposal, not audited for production"
  },
  "color": {
    "brand": {
      "green": "#0F3D36",
      "green-strong": "#0A332C",
      "green-action": "#115846",
      "clay": "#C1492E",
      "clay-text": "#8F2D1C",
      "maize": "#F2C768",
      "mint": "#DDEADF",
      "agave": "#93B6A1"
    },
    "surface": {
      "canvas": "#F9F6EE",
      "card": "#FFFDF7",
      "subtle": "#F2EBDF",
      "selected": "#E8F2E8",
      "dark": "#0F3D36",
      "dark-card": "#174F42"
    },
    "text": {
      "primary": "#1F2622",
      "secondary": "#515B54",
      "inverted": "#FFFDF7",
      "link": "#0F5B4A"
    },
    "border": {
      "default": "#D8CFC0",
      "subtle": "#E8DFD2",
      "strong": "#6A736B",
      "focus": "#0E6F5A"
    },
    "state": {
      "verified-background": "#E2F3E7",
      "verified-text": "#0A5039",
      "pending-background": "#FFF0D2",
      "pending-text": "#725012",
      "error-background": "#FBE9E6",
      "error-text": "#8A281B",
      "draft-background": "#EAEAE7",
      "draft-text": "#434B45",
      "offline-background": "#E9ECF3",
      "offline-text": "#293B68"
    }
  },
  "font": {
    "display": "Fraunces, Georgia, serif",
    "ui": "Inter, system-ui, -apple-system, Segoe UI, sans-serif",
    "number": "Inter, system-ui, sans-serif"
  },
  "fontSize": {
    "xs": "0.8125rem",
    "sm": "0.9375rem",
    "base": "1rem",
    "md": "1.125rem",
    "lg": "1.25rem",
    "xl": "1.5rem",
    "2xl": "2rem",
    "3xl": "2.5rem",
    "money": "clamp(2rem, 3.6vw, 3rem)"
  },
  "lineHeight": {
    "tight": 1.2,
    "body": 1.5,
    "relaxed": 1.65
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px"
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "16px",
    "xl": "22px",
    "pill": "999px"
  },
  "shadow": {
    "card": "0 2px 8px rgb(31 38 34 / 5%)",
    "raised": "0 12px 30px rgb(31 38 34 / 12%)"
  },
  "layout": {
    "sidebar": "232px",
    "content-max": "1440px",
    "grid-gap": "16px",
    "tap-target-web": "44px",
    "tap-target-mobile": "48px",
    "desktop-breakpoint": "1000px",
    "tablet-breakpoint": "720px"
  },
  "motion": {
    "fast": "120ms",
    "normal": "180ms",
    "slow": "250ms",
    "easing": "cubic-bezier(.2,.7,.2,1)"
  },
  "zIndex": {
    "base": 0,
    "sticky": 20,
    "drawer": 80,
    "dialog": 100,
    "toast": 120
  }
}